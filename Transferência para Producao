--Chamado Estoque 762102

SELECT T.NROEMPRESA AS EMPRESA,
TO_CHAR(T.DTAENTRADASAIDA,'DD/MM/YYYY') AS DTAENTSAIDA,
       T.SEQPRODUTOSAIDA AS PLU_BASE,
       T.DESCPRODUTOSAIDA AS PRODUTO_BASE,
  TRUNC(SUM(T.QTDLANCTOSAIDA),2) AS QTD_SAIDA,
  TRUNC(SUM(T.CUSTOSAIDA),2) AS CUSTO_SAIDA ,
       T.LOCALORIGEM,
       T.FATORCONVERSAO,
       T.SEQPRODUTOENTRADA AS PLU_INSUMO,
       T.DESCPRODUTOENTRADA AS INSUMO,
       T.EMBALAGEMENTRADA,
  TRUNC(SUM(T.QTDLANCTOENTRADA),2) AS QTD_ENTRDA,
  TRUNC(SUM(T.CUSTOENTRADA),2) AS CUSTO_ENTRADA ,
       T.LOCALDESTINO,
       T.USULANCTO,
TO_CHAR(T.DTAHORLANCTO, 'DD/MM/YYYY') AS DTAHORLANCTO
FROM CONSINCO.MAXV_TRANSFPRODUCAO T
   WHERE TIPOREG = 'T'
   AND (DTAENTRADASAIDA) >= :DT1
   AND (DTAENTRADASAIDA) <= :DT2
   AND NROEMPRESA IN (#LS1)
   GROUP BY
    T.NROEMPRESA,
       T.DTAENTRADASAIDA,
       T.SEQPRODUTOSAIDA,
       T.DESCPRODUTOSAIDA,
       T.EMBALAGEMSAIDA,
       T.LOCALORIGEM,
       T.FATORCONVERSAO,
       T.SEQPRODUTOENTRADA,
       T.DESCPRODUTOENTRADA,
       T.EMBALAGEMENTRADA,
       T.LOCALDESTINO,
       T.USULANCTO,
       T.DTAHORLANCTO
UNION
SELECT DISTINCT A.NROEMPRESA,
TO_CHAR(A.DTAENTRADASAIDA, 'DD/MM/YYYY'),
A.SEQPRODUTO,
B.DESCCOMPLETA,
A.QTDLANCTO, 
ROUND(A.VALORVLRNF,2),
CASE
WHEN A.LOCAL IN (1,3,159,165,471,500,520,582,591,659,668,673) THEN 'LOJA'
WHEN A.LOCAL IN (2,4,160,476,491,499,526,590,599,660,669,674) THEN 'AVARIA'
END,
F.FATORCONVERSAO,
C.SEQPRODUTO,
D.DESCCOMPLETA, 
TO_CHAR(E.QTDEMBALAGEM),
C.QTDLANCTO,
ROUND(C.VALORVLRNF,2),
A.HISTORICO, 
CASE WHEN A.USULANCTO LIKE 'TKT%' THEN 'NAP'
END,
TO_CHAR(A.DTAENTRADASAIDA, 'DD/MM/YYYY')
FROM CONSINCO.MRL_LANCTOESTOQUE A
INNER JOIN CONSINCO.MAP_PRODUTO B ON B.SEQPRODUTO = A.SEQPRODUTO 
INNER JOIN CONSINCO.MRL_LANCTOESTOQUE C ON A.SEQMOVTOESTQ + 1 = C.SEQMOVTOESTQ 
                                        AND A.NROEMPRESA = C.NROEMPRESA 
                                        AND A.DTAENTRADASAIDA = C.DTAENTRADASAIDA
INNER JOIN CONSINCO.MAP_PRODUTO D ON D.SEQPRODUTO = C.SEQPRODUTO
INNER JOIN CONSINCO.MRL_PRODEMPSEG E ON A.SEQPRODUTO = E.SEQPRODUTO 
                                     AND A.NROEMPRESA = E.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODINSUMO F ON A.SEQPRODUTO = F.SEQPRODUTO
WHERE A.NROEMPRESA IN (#LS1)
AND A.DTAENTRADASAIDA BETWEEN :DT1 AND :DT2
AND A.USULANCTO LIKE 'TKT%'
AND A.TIPLANCTO = 'S'
AND C.USULANCTO LIKE 'TKT%'
AND C.TIPLANCTO = 'E'
AND E.QTDEMBALAGEM = 1
AND A.HISTORICO = 'Transferência para Produção via API'
UNION 
SELECT DISTINCT G.NROEMPRESA,
TO_CHAR(G.DTAENTRADASAIDA, 'DD/MM/YYYY'),
G.SEQPRODUTO as PROD_SAIDA,
H.DESCCOMPLETA,
G.QTDLANCTO, 
ROUND(G.VALORVLRNF,2) AS CUSTO_SAIDA,
CASE
WHEN G.LOCAL IN (1,3,159,165,471,500,520,582,591,659,668,673) THEN 'LOJA'
WHEN G.LOCAL IN (2,4,160,476,491,499,526,590,599,660,669,674) THEN 'AVARIA'
END AS LOCAL_ORIGEM,
L.FATORCONVERSAO,
I.SEQPRODUTO AS PLU_INSUMO,
J.DESCCOMPLETA AS INSUMO, 
TO_CHAR(K.QTDEMBALAGEM),
I.QTDLANCTO,
ROUND(I.VALORVLRNF,2) AS CUSTO_ENTRADA,
G.HISTORICO, 
CASE WHEN G.USULANCTO LIKE 'TKT%' THEN 'NAP'
END,
TO_CHAR(G.DTAENTRADASAIDA, 'DD/MM/YYYY')
FROM CONSINCO.MRL_LANCTOESTOQUE G
INNER JOIN CONSINCO.MAP_PRODUTO H ON H.SEQPRODUTO = G.SEQPRODUTO 
INNER JOIN CONSINCO.MRL_LANCTOESTOQUE I ON G.SEQPRODUTO = I.SEQPRODUTO 
                                        AND G.NROEMPRESA = I.NROEMPRESA 
                                        AND G.DTAENTRADASAIDA = I.DTAENTRADASAIDA
                                        AND G.QTDLANCTO = I.QTDLANCTO
INNER JOIN CONSINCO.MAP_PRODUTO J ON J.SEQPRODUTO = I.SEQPRODUTO
INNER JOIN CONSINCO.MRL_PRODEMPSEG K ON G.SEQPRODUTO = K.SEQPRODUTO 
                                     AND G.NROEMPRESA = K.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODINSUMO L ON G.SEQPRODUTO = L.SEQPRODUTO
WHERE G.NROEMPRESA IN (#LS1)
AND G.DTAENTRADASAIDA BETWEEN :DT1 AND :DT2
AND G.USULANCTO LIKE 'TKT%'
AND I.USULANCTO LIKE 'TKT%'
AND K.QTDEMBALAGEM = 1
AND G.LOCAL IN (1,3,159,165,471,500,520,582,591,659,668,673)
AND G.HISTORICO != 'Transferência para Produção via API'
ORDER BY PRODUTO_BASE;
