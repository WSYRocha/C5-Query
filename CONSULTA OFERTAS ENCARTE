SELECT DISTINCT A.SEQENCARTE, 
A.DESCRICAO AS DESCRICAO_ENCARTE, 
E.COMPRADOR AS COMPRADOR,
D.CATEGORIAN1 AS CATEGORIA,
G.SEQFAMILIA,
H.SEQSIMILARIDADE,
B.SEQPRODUTO AS PLU,
CC.DESCCOMPLETA AS DESCRICAO_PRODUTO,
TO_CHAR(A.DTAINICIO, 'DD/MM/YYYY') AS DATA_INICIO,
TO_CHAR(A.DTAFIM, 'DD/MM/YYYY') AS DATA_FIM,
TO_CHAR(F.PRECOBASENORMAL, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS DE,
TO_CHAR(B.PRECOPROMOCIONAL, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS OFERTA,
TO_CHAR(B.PRECOCARTAOPROPRIO, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS CARTAO
FROM CONSINCO.MRL_ENCARTE A
INNER JOIN CONSINCO.MRL_ENCARTEPRODUTO B ON A.SEQENCARTE = B.SEQENCARTE
INNER JOIN CONSINCO.MAP_PRODUTO C ON B.SEQPRODUTO = C.SEQPRODUTO
INNER JOIN CONSINCO.ETLV_CATEGORIA_V2 D ON C.SEQFAMILIA = D.SEQFAMILIA
INNER JOIN CONSINCO.MAX_COMPRADOR E ON D.seqcomprador = E.SEQCOMPRADOR
INNER JOIN CONSINCO.MRL_PRODEMPSEG F ON C.SEQPRODUTO = F.SEQPRODUTO
LEFT JOIN CONSINCO.MAP_FAMILIA G ON C.SEQFAMILIA = G.SEQFAMILIA
LEFT JOIN CONSINCO.MAP_PRODUTO CC ON CC.SEQFAMILIA = G.SEQFAMILIA
LEFT JOIN CONSINCO.MAP_PRODSIMILAR H ON B.SEQPRODUTO = H.SEQPRODUTO
LEFT JOIN CONSINCO.MAP_PRODUTO CCC ON CCC.SEQPRODUTO = H.SEQPRODUTO
WHERE A.SEQENCARTE = :NR1
AND F.NROEMPRESA = 46
AND F.QTDEMBALAGEM = 1
ORDER BY D.CATEGORIAN1;
