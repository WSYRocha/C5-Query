--OFICIAL

SELECT DISTINCT X.SEQPRODUTO AS PLU,
K.DESCCOMPLETA AS PRODUTO,
Z.USUAUDITORIA AS USUARIO,
Z.DESCCAMPO AS CAMPO_ALTERADO,
Z.VLRANTERIOR AS DE,
Z.VLRATUAL AS PARA,
TO_CHAR(Z.DTAHORAUDITORIA, 'DD/MM/YYYY HH24:MI') AS DATA, 
X.NROEMPRESA AS EMPRESA, 
CASE 
WHEN TO_CHAR(X.NROSEGMENTO) = '1' THEN 'CD_GRU'
WHEN TO_CHAR(X.NROSEGMENTO) = '2' THEN 'NAGUMO_SP'
WHEN TO_CHAR(X.NROSEGMENTO) = '3' THEN 'RIO_DE_JANEIRO'
WHEN TO_CHAR(X.NROSEGMENTO) = '4' THEN 'MIXTER_ATACAREJ'
WHEN TO_CHAR(X.NROSEGMENTO) = '5' THEN 'ECOMMERCE'
WHEN TO_CHAR(X.NROSEGMENTO) = '7' THEN 'NAG_HIBRIDO'
WHEN TO_CHAR(X.NROSEGMENTO) = '8' THEN 'ECOMMER_MIXTER'
WHEN TO_CHAR(X.NROSEGMENTO) = '9' THEN 'TELEVENDAS'
WHEN TO_CHAR(X.NROSEGMENTO) = '10' THEN 'BAKESHOP'
END AS SEGMENTO,
K.INDINTEGRAECOMMERCE AS INTG_ECOM,
K.PERSIMILIARECOMMERCE AS SIMILAR_ECOM,
CASE
WHEN Y.STATUSCOMPRA = 'A' THEN 'ATIVO'
WHEN Y.STATUSCOMPRA = 'S' THEN 'SUSPENSO'
WHEN Y.STATUSCOMPRA = 'I' THEN 'INATIVO'
END AS STATUS_COMPRA
from CONSINCO.MRL_PRODEMPSEG X
inner join CONSINCO.MAP_AUDITORIA Z 
ON X.SEQPRODUTO = Z.SEQIDENTIFICA 
AND X.NROEMPRESA = TO_NUMBER(REGEXP_REPLACE(Z.IDENTIFICADOR, '[^0-9]', ''))
LEFT JOIN CONSINCO.MRL_PRODUTOEMPRESA Y 
ON X.SEQPRODUTO = Y.SEQPRODUTO AND Y.NROEMPRESA = X.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODUTO K ON K.SEQPRODUTO = X.SEQPRODUTO
WHERE Z.DTAAUDITORIA BETWEEN :DT1 AND :DT2
AND Z.CAMPO = 'STATUSCOMPRA'
AND Z.TABELA = 'MRL_PRODUTOEMPRESA'
AND X.QTDEMBALAGEM = 1
AND Y.ESTQLOJA > 0
AND X.PRECOVALIDNORMAL > 0
AND X.STATUSVENDA = 'A'
AND (K.INDINTEGRAECOMMERCE IS NULL OR K.INDINTEGRAECOMMERCE = 'N'
OR K.PERSIMILIARECOMMERCE IS NULL OR K.PERSIMILIARECOMMERCE = 'N')
UNION 
SELECT A.SEQIDENTIFICA, 
B.DESCCOMPLETA,
A.USUAUDITORIA,
A.DESCCAMPO, 
A.VLRANTERIOR, 
A.VLRATUAL, 
TO_CHAR(A.DTAHORAUDITORIA, 'DD/MM/YYYY HH24:MI'),
TO_NUMBER(''),
TO_CHAR(''),
B.INDINTEGRAECOMMERCE,
B.PERSIMILIARECOMMERCE,
('')
FROM CONSINCO.MAP_AUDITORIA A
INNER JOIN CONSINCO.MAP_PRODUTO B
ON A.SEQIDENTIFICA = B.SEQPRODUTO
WHERE A.CAMPO = 'INDINTEGRAECOMMERCE'
AND A.TABELA = 'MAP_PRODUTO'
AND (B.INDINTEGRAECOMMERCE IS NULL OR B.INDINTEGRAECOMMERCE = 'N'
OR B.PERSIMILIARECOMMERCE IS NULL OR B.PERSIMILIARECOMMERCE = 'N')
AND A.DTAAUDITORIA BETWEEN :DT1 AND :DT2
ORDER BY PRODUTO, EMPRESA, DATA DESC;
