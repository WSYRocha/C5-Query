SELECT /*+ ORDERED */
ERJ.SEQENCARTE,
AGRUPRJ.APELIDO AS SEGMENTO,
CPRJ.COMPRADOR,
CRJ.CATEGORIAN1 AS CATEGORIA,
PPPRJ.SEQPRODUTO,
PPPRJ.DESCCOMPLETA,
PPPRJ.SEQFAMILIA,
SSRJ.SEQSIMILARIDADE,
TO_CHAR(ERJ.DTAINICIO, 'DD/MM/YYYY') AS DATA_INICIO,
TO_CHAR(ERJ.DTAFIM, 'DD/MM/YYYY') AS DATA_FIM,
TO_CHAR(PSRJ.PRECOVALIDNORMAL, 'FM999999990D00') AS DE,
TO_CHAR(MAX(CASE
    WHEN EPRJ.NROAGRUPAMENTO IN (103, 106, 108)
    THEN EPRJ.PRECOPROMOC
    WHEN EPRJ.NROAGRUPAMENTO = 107
    AND EPRJ.PRECOPROMOC > 0
    THEN EPRJ.PRECOPROMOC END),'FM999999990D00') AS PRECO_PROMOCAO,
CASE
    WHEN EPRJ.NROAGRUPAMENTO = 106 THEN
(SELECT TO_CHAR(
NVL(NULLIF(EPMNRJ.PRECOPROMOC, 0),
    NULLIF(EPMNRJ.PRECOCARTAO, 0)),'FM999999990D00')
FROM CONSINCO.MRL_ENCARTEPRODUTOPRECO EPMNRJ
      WHERE EPMNRJ.SEQENCARTE = EPRJ.SEQENCARTE
      AND EPMNRJ.SEQPRODUTO = EPRJ.SEQPRODUTO
      AND EPMNRJ.NROAGRUPAMENTO = 104)
WHEN EPRJ.NROAGRUPAMENTO = 103 THEN(SELECT TO_CHAR(
NVL(NULLIF(EPMNRJ.PRECOPROMOC, 0),
    NULLIF(EPMNRJ.PRECOCARTAO, 0)),'FM999999990D00')
FROM CONSINCO.MRL_ENCARTEPRODUTOPRECO EPMNRJ
      WHERE EPMNRJ.SEQENCARTE = EPRJ.SEQENCARTE
     AND EPMNRJ.SEQPRODUTO = EPRJ.SEQPRODUTO
     AND EPMNRJ.NROAGRUPAMENTO = 102)END AS MEU_NAGUMO,
TO_CHAR(MAX(CASE
    WHEN EPRJ.NROAGRUPAMENTO in (103, 106, 108)
      THEN EPRJ.PRECOCARTAO END), 'FM999999990D00') AS CARTAO_NAGUMO
FROM CONSINCO.MRL_ENCARTE ERJ
INNER JOIN CONSINCO.MRL_ENCARTEPRODUTOPRECO EPRJ
    ON ERJ.SEQENCARTE = EPRJ.SEQENCARTE
INNER JOIN CONSINCO.MAP_PRODUTO PRJ
    ON PRJ.SEQPRODUTO = EPRJ.SEQPRODUTO
INNER JOIN CONSINCO.MAP_PRODUTO PPRJ
    ON PPRJ.SEQFAMILIA = PRJ.SEQFAMILIA
LEFT JOIN CONSINCO.MAP_PRODSIMILAR SRJ
    ON SRJ.SEQPRODUTO = PPRJ.SEQPRODUTO
LEFT JOIN CONSINCO.MAP_PRODSIMILAR SSRJ
    ON SSRJ.SEQSIMILARIDADE = SRJ.SEQSIMILARIDADE
LEFT JOIN CONSINCO.MAP_PRODUTO PPPRJ
    ON PPPRJ.SEQPRODUTO = NVL(SSRJ.SEQPRODUTO, PPRJ.SEQPRODUTO)
LEFT JOIN CONSINCO.ETLV_CATEGORIA_V2 CRJ
    ON CRJ.SEQFAMILIA = NVL(PPPRJ.SEQFAMILIA, PPRJ.SEQFAMILIA)
LEFT JOIN CONSINCO.MAX_COMPRADOR CPRJ
    ON CPRJ.SEQCOMPRADOR = CRJ.SEQCOMPRADOR
INNER JOIN CONSINCO.MRL_PRODEMPSEG PSRJ
    ON PSRJ.SEQPRODUTO = NVL(PPPRJ.SEQPRODUTO, PPRJ.SEQPRODUTO)
INNER JOIN CONSINCO.MAX_AGRUPAMENTO AGRUPRJ
    ON AGRUPRJ.NROAGRUPAMENTO = EPRJ.NROAGRUPAMENTO
    AND PSRJ.QTDEMBALAGEM = 1
    AND PSRJ.NROEMPRESA = 46
WHERE ERJ.SEQENCARTE = #NR1
  AND AGRUPRJ.APELIDO IN (#LS1)
GROUP BY
    ERJ.SEQENCARTE,PPPRJ.SEQPRODUTO,CPRJ.COMPRADOR,CRJ.CATEGORIAN1,PPPRJ.DESCCOMPLETA,PPPRJ.SEQFAMILIA,SSRJ.SEQSIMILARIDADE,
    ERJ.DTAINICIO,ERJ.DTAFIM,PSRJ.PRECOVALIDNORMAL,EPRJ.SEQENCARTE,EPRJ.SEQPRODUTO,AGRUPRJ.APELIDO,EPRJ.NROAGRUPAMENTO
    

HAVING (MAX(CASE
  WHEN EPRJ.NROAGRUPAMENTO IN (103, 106)
  THEN EPRJ.PRECOPROMOC
  WHEN EPRJ.NROAGRUPAMENTO IN (107, 108)
  AND EPRJ.PRECOPROMOC > 0
  THEN EPRJ.PRECOPROMOC
    END) IS NOT NULL 
OR MAX(CASE
  WHEN EPRJ.NROAGRUPAMENTO IN (103, 106, 108)
  AND EPRJ.PRECOCARTAO > 0
  THEN EPRJ.PRECOCARTAO END) IS NOT NULL)
ORDER BY 2, 4, 6;
