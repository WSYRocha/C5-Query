SELECT LINHA, 
EMISSAO_ACO, 
NRO_ACORDO, 
DESCRICAO DESC_ACO, 
PARCELA, 
TO_CHAR(DTAVENCIMENTO, 'DD/MM/YYYY') VENCTO_PARCELA,
DTAQUITACAO, 
INFO_QUIT, 
COMPRADOR, 
COD_FORNECEDOR, 
VLR_ACORDO, 
VLR_PARCELA, 
VLR_ABERTO, 
VLR_OPERACAO, 
REDE
FROM (SELECT SEQTITULO, 
'TIT' LINHA, 
TO_CHAR(X.DATA_EMISSAO, 'DD/MM/YYYY') EMISSAO_ACO, 
X.NRO_ACORDO, 
X.DESCACORDO DESCRICAO, 
NROPARCELA||'/'||QTDPARCELA PARCELA, 
F.DTAVENCIMENTO,
NULL DTAQUITACAO, 
NULL INFO_QUIT, 
X.COMPRADOR, 
X.COD_FORNECEDOR,
X.VLR_ACORDO, 
F.VLRORIGINAL VLR_PARCELA, 
F.VLRORIGINAL - F.VLRPAGO VLR_ABERTO, 
NULL VLR_OPERACAO, 
R.DESCRICAO REDE
FROM FI_TITULO F INNER JOIN NAGV_TAE_ACORDOS_V4 X ON X.NRO_ACORDO = F.NROTITULO 
                                                  AND F.NROEMPRESA = NVL(X.NROEMPRACORDOPROMOC,X.NRO_EMPRESA) 
                                                  AND F.SITUACAO != 'C' 
                                                  AND F.SEQPESSOA = X.COD_FORNECEDOR
                 INNER JOIN CONSINCO.GE_REDEPESSOA RP ON RP.SEQPESSOA = X.COD_FORNECEDOR
                 INNER JOIN CONSINCO.GE_REDE R ON R.SEQREDE = RP.SEQREDE
WHERE X.DATA_EMISSAO BETWEEN :DT1 AND :DT2
AND X.COMPRADOR IN (#LS1)
AND R.DESCRICAO IN (#LS2)
AND F.CODESPECIE LIKE 'AC%'
 
UNION ALL
 
SELECT F.SEQTITULO, 
'OPE',
TO_CHAR('', 'DD/MM/YYYY'), 
TO_NUMBER(NULL), 
'', 
'', 
TO_DATE(NULL),
TO_CHAR(NVL((SELECT MAX(F1.DTAEMISSAO) FROM FI_TITULO F1 WHERE F1.SEQTITULO = (SELECT MAX(SEQTITULO) FROM FI_TITOPERACAO O2 WHERE O2.NROPROCESSO = O.NROPROCESSO) AND CODESPECIE IN ('ANTREC')), O.DTAOPERACAO), 'DD/MM/YYYY')DTAQUITACAO,
O.OBSERVACAO, 
'', 
TO_NUMBER(''), 
NULL VLR_ACORDO, 
NULL VLR_PARCELA,
NULL VLR_ABERTO,
O.VLROPERACAO, 
R.DESCRICAO REDE
FROM FI_TITULO F INNER JOIN NAGV_TAE_ACORDOS_V4 X ON X.NRO_ACORDO = F.NROTITULO 
                                                  AND F.NROEMPRESA = NVL(X.NROEMPRACORDOPROMOC,X.NRO_EMPRESA) 
                                                  AND F.SITUACAO != 'C' 
                                                  AND F.SEQPESSOA = X.COD_FORNECEDOR
                 INNER JOIN CONSINCO.GE_REDEPESSOA RP ON RP.SEQPESSOA = X.COD_FORNECEDOR
                 INNER JOIN CONSINCO.GE_REDE R ON R.SEQREDE = RP.SEQREDE
                 INNER JOIN FI_TITOPERACAO O ON O.SEQTITULO = F.SEQTITULO
WHERE X.DATA_EMISSAO BETWEEN :DT1 AND :DT2
AND R.DESCRICAO IN (#LS2)
AND O.OPCANCELADA IS NULL
AND CODOPERACAO in (28,17)
AND F.CODESPECIE LIKE 'AC%'   
ORDER BY 1 , 3 desc, DTAQUITACAO);
