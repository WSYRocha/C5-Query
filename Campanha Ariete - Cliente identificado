SELECT I.NROEMPRESA,
I.SEQPRODUTO PLU,
SUM(I.VLRITEM - I.VLRDESCONTO) / NULLIF(SUM(I.QUANTIDADE), 0) AS VALOR_COM_DESCONTO,
SUM(I.VLRITEM - I.VLRDESCONTO) AS VALOR_TOTAL,
SUM(I.QUANTIDADE) AS QUANTIDADE,
P.DESCCOMPLETA AS PRODUTO,
COUNT(DISTINCT F.CNPJCPF) AS TOTAL_CLIENTES
FROM CONSINCO.MFL_DOCTOFISCAL X
INNER JOIN CONSINCO.MFL_DFITEM I 
ON I.SEQNF = X.SEQNF
INNER JOIN CONSINCO.MAP_PRODUTO P 
ON I.SEQPRODUTO = P.SEQPRODUTO
INNER JOIN CONSINCO.MFL_DOCTOFIDELIDADE F 
ON I.SEQNF = F.SEQNF
WHERE X.DTAMOVIMENTO BETWEEN '12-AGO-2026' AND '15-AGO-2026'
AND X.NROEMPRESA = :LS1
AND I.SEQPRODUTO IN (
        276525,
        276529,
        276532,
        276533,
        276536,
        276537,
        276538,
        276539,
        276540,
        276541,
        276543,
        276544
      )
AND I.STATUSITEM = 'V'
AND X.STATUSDF = 'V'
GROUP BY I.NROEMPRESA,I.SEQPRODUTO, I.STATUSITEM, P.DESCCOMPLETA,X.STATUSDF
ORDER BY I.NROEMPRESA, I.SEQPRODUTO;
