SELECT A.DESCTIPESPECIE AS LOJA_DESTINO,
A.SEQPRODUTO AS PLU,
A.DESCREDUZIDA AS DESCRICAO,
SUM(A.QUANTIDADEEMB) AS QUANTIDADE,
A.EMBALAGEM,
TO_CHAR(B.DTAHORINICARREG, 'DD/MM/YYYY HH24:MI') AS INICIO_CARREG,
TO_CHAR(B.DTAHORFIMCARREG, 'DD/MM/YYYY HH24:MI') AS FIM_CARREG,
A.NROEMPRESA AS EMP_ORIGEM,
TO_CHAR(A.DTAVALIDADE, 'DD/MM/YYYY') AS VALIDADE,
C.DOCUMENTO,
B.USUCARREG,
B.TIPOETQPALETECARREG || B.SEQPALETECARREG AS ETIQUETA_MASTER
FROM CONSINCO.MLOV_CONTROLEETQSORTERCARREG A 
INNER JOIN CONSINCO.MLO_PALETECARREG B ON A.SEQPALETECARREG = B.SEQPALETECARREG
INNER JOIN CONSINCO.MLOV_PEDVENDA_SORTER C ON A.SEQPALETECARREG = C.SEQPALETECARREG AND A.SEQPRODUTO = C.SEQPRODUTO 
WHERE A.NROEMPRESA IN (502, 507, 508)
AND TRUNC(B.DTAHORINIMONT) BETWEEN :DT1 AND :DT2
AND A.TIPESPECIE = :LT1
GROUP BY A.DESCTIPESPECIE,
A.SEQPRODUTO,
A.DESCREDUZIDA,
A.EMBALAGEM,
B.DTAHORINICARREG,
B.DTAHORFIMCARREG,
A.NROEMPRESA,
A.DTAVALIDADE,
C.DOCUMENTO,
B.USUCARREG,
B.TIPOETQPALETECARREG || B.SEQPALETECARREG
ORDER BY B.DTAHORINICARREG, A.DESCREDUZIDA, B.TIPOETQPALETECARREG || B.SEQPALETECARREG;
