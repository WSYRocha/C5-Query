SELECT /*+ ORDERED */ 
DISTINCT E.SEQENCARTE,
CP.COMPRADOR,
C.CATEGORIAN1 AS CATEGORIA,
PPP.SEQPRODUTO AS PLU,
PPP.DESCCOMPLETA,
PPP.SEQFAMILIA,
SS.SEQSIMILARIDADE,
EN.DTAINICIO,
EN.DTAFIM,
TO_CHAR(PS.PRECOBASENORMAL, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS DE,
TO_CHAR(E.PRECOPROMOCIONAL, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS OFERTA,
TO_CHAR(E.PRECOCARTAOPROPRIO, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS CARTAO
FROM CONSINCO.MRL_ENCARTEPRODUTO E
INNER JOIN CONSINCO.MAP_PRODUTO P
ON E.SEQPRODUTO = P.SEQPRODUTO
INNER JOIN CONSINCO.MAP_PRODUTO PP
ON PP.SEQFAMILIA = P.SEQFAMILIA
LEFT JOIN CONSINCO.MAP_PRODSIMILAR S
ON S.SEQPRODUTO = PP.SEQPRODUTO
LEFT JOIN CONSINCO.MAP_PRODSIMILAR SS
ON SS.SEQSIMILARIDADE = S.SEQSIMILARIDADE
LEFT JOIN CONSINCO.MAP_PRODUTO PPP
ON PPP.SEQPRODUTO = NVL(SS.SEQPRODUTO, PP.SEQPRODUTO)
LEFT JOIN CONSINCO.ETLV_CATEGORIA_V2 C
ON C.SEQFAMILIA  = NVL(PPP.SEQFAMILIA, PP.SEQFAMILIA)
LEFT JOIN CONSINCO.MAX_COMPRADOR CP 
ON CP.SEQCOMPRADOR = C.seqcomprador
INNER JOIN CONSINCO.MRL_PRODEMPSEG PS
ON PS.SEQPRODUTO = NVL(PPP.SEQPRODUTO, PP.SEQPRODUTO) AND PS.QTDEMBALAGEM = 1 AND PS.NROEMPRESA = 46
INNER JOIN CONSINCO.MRL_ENCARTE EN
ON EN.SEQENCARTE = E.SEQENCARTE
WHERE E.SEQENCARTE = 45043
AND NOT EXISTS (SELECT 1 FROM CONSINCO.MAP_SIMILARIDADE SM WHERE SM.SEQSIMILARIDADE = s.SEQSIMILARIDADE AND SM.TIPOSIMILARIDADE != 'S')
ORDER BY 3, 5, 6;
