-- Chamado 776774

SELECT DISTINCT A.NROEMPRESA AS EMPRESA,
A.SEQPRODUTO AS PLU, 
B.DESCCOMPLETA AS PRODUTO, 
TO_CHAR(A.DTAHORINCLUSAO, 'DD/MM/YYYY') AS DATA_INCLUSAO, 
A.OBSERVACAO, 
A.USUINCLUSAO AS USUARIO_INCLUSAO, 
TO_CHAR(A.DTAINICIAL, 'DD/MM/YYYY') AS DATA_INICIO, 
TO_CHAR(A.DTAFINAL, 'DD/MM/YYYY') AS DATA_FIM, 
TO_CHAR(A.VLRUNITVERBA, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS VALOR_VERBA,
TO_CHAR(A.QTDUTILIZADAVERBA, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS VALOR_UTILIZADA_VERBA
FROM CONSINCO.MRL_CUSTOVERBA A
INNER JOIN CONSINCO.MAP_PRODUTO B ON A.SEQPRODUTO = B.SEQPRODUTO
WHERE A.DTAINICIAL >= :DT1
AND A.DTAFINAL <= :DT2
AND A.SEQPRODUTO IN (#LT1)
GROUP BY A.NROEMPRESA, A.SEQPRODUTO, B.DESCCOMPLETA, A.DTAHORINCLUSAO, A.OBSERVACAO, A.USUINCLUSAO, A.DTAINICIAL, A.DTAFINAL, A.VLRUNITVERBA, A.QTDUTILIZADAVERBA
ORDER BY 2, 1;
