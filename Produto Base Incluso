SELECT A.SEQPRODUTO AS PLU, 
A.DESCCOMPLETA AS DESC_COMPLETA, 
A.SEQPRODUTOBASE AS PLU_PRODUTO_BASE, 
PA.DESCCOMPLETA AS DESC_COMPLETA_PRODUTO_BASE
FROM CONSINCO.MAP_PRODUTO A INNER JOIN CONSINCO.MAP_PRODUTO PA ON A.SEQPRODUTOBASE = PA.SEQPRODUTO
WHERE A.SEQPRODUTOBASE IS NOT NULL
ORDER BY A.DESCCOMPLETA;
