--CHAMADO 763272

SELECT A.SEQPESSOA, 
B.NOMERAZAO,
A.NROEMPRESA,
A.CODESPECIE AS ESPECIE, 
A.SEQTITULO,
A.DTAEMISSAO AS EMISSAO, 
A.DTAPROGRAMADA, 
A.VLRNOMINAL AS VLR_ABERTO,
SUM((A.VLRNOMINAL) - (A.VLRPAGO)) AS VLR_LIQUIDO,
A.OBSERVACAO AS OBSERVACAO,
A.USUALTERACAO
FROM CONSINCO.FI_TITULO A INNER JOIN CONSINCO.GE_PESSOA B
ON A.SEQPESSOA = B.SEQPESSOA
WHERE A.CODESPECIE = 'ANTPAG'
GROUP BY A.SEQPESSOA, 
B.NOMERAZAO,
A.NROEMPRESA,
A.CODESPECIE, 
A.SEQTITULO,
A.DTAEMISSAO, 
A.DTAPROGRAMADA, 
A.VLRNOMINAL,
A.OBSERVACAO,
A.USUALTERACAO
ORDER BY A.DTAEMISSAO DESC;
