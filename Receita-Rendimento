-- Chamado 769962 - Incluindo Status

SELECT DISTINCT A.SEQRECEITARENDTO AS CODIGO_RECEITA,
A.RECEITARENDTO AS DESCRICAO_PRINCIPAL_RECEITA_RENDIMENTO,
CASE 
WHEN A.INDRECEITARENDTO = 'N' THEN 'RENDIMENTO'
WHEN A.INDRECEITARENDTO = 'C' THEN 'RECEITA'
END AS RECEITA_RENDIMENTO,
C.SEQPRODUTO AS SEQ_COMPONENTES,
C.DESCCOMPLETA AS DESCRICAO_COMPLETA_COMPONENTES,
D.SEQPRODUTOFINAL AS PLU_FINAL,
D.PRODUTOFINAL AS DESCRICAO_PRODUTO_FINAL,
TO_CHAR(A.DTAHORALTERACAO, 'DD/MM/YYYY HH24:MI') AS DATA_ALTERACAO,
CASE 
WHEN A.STATUSRECRENDTO = 'A' THEN 'ATIVO'
WHEN A.STATUSRECRENDTO = 'I' THEN 'INATIVO'
END AS STATUS
FROM CONSINCO.MRL_RECEITARENDTO A INNER JOIN CONSINCO.MRL_RRCOMPONENTE B ON A.SEQRECEITARENDTO = B.SEQRECEITARENDTO
INNER JOIN CONSINCO.MAP_PRODUTO C ON B.SEQPRODUTO = C.SEQPRODUTO
INNER JOIN CONSINCO.MRLV_COMPONENTESRECEITA D ON A.SEQRECEITARENDTO = D.SEQRECEITARENDTO
WHERE A.STATUSRECRENDTO IN (#LS1)
ORDER BY A.SEQRECEITARENDTO;
