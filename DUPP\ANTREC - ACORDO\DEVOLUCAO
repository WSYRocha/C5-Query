SELECT DISTINCT
B.NOMERAZAO, 
B.NROCGCCPF||'-'||B.DIGCGCCPF AS CNPJ, 
A.NROEMPRESA AS EMPRESA, 
C.CODOPERACAO,
D.DESCRICAO,
TO_CHAR(A.NROTITULO) AS TITULO,
A.SERIETITULO AS SERIE,
TO_CHAR('TITULO REFERENCIA') AS TITULO_REFERENCIA, 
A.CODESPECIE,
C.OBSERVACAO,
TO_CHAR(A.DTAPROGRAMADA, 'DD/MM/YYYY') AS DATA_PROGRAMADA,
TO_CHAR(A.DTAQUITACAO, 'DD/MM/YYYY') AS DATA_QUITACAO,
TO_CHAR(A.VLRNOMINAL, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS VALOR_NOMINAL,
TO_CHAR(A.VLRPAGO, 'FM999999990D00', 'NLS_NUMERIC_CHARACTERS='',.''') AS VALOR_PAGO
FROM CONSINCO.FI_TITULO A 
INNER JOIN CONSINCO.GE_PESSOA B ON A.SEQPESSOA = B.SEQPESSOA
INNER JOIN CONSINCO.FI_TITOPERACAO C ON C.SEQTITULO = A.SEQTITULO
INNER JOIN CONSINCO.FI_OPERACAO D ON C.CODOPERACAO = D.CODOPERACAO
INNER JOIN CONSINCO.GE_REDEPESSOA E ON E.SEQPESSOA = A.SEQPESSOA
WHERE A.CODESPECIE IN ('DUPP', 'ANTREC')
AND A.DTAVENCIMENTO BETWEEN :DT1 AND :DT2
AND E.SEQREDE =  :LT1
AND A.VLRPAGO > 0
AND D.DESCRICAO LIKE ('%Desco%')
AND D.DESCRICAO NOT IN 'Desconto Funrural'

UNION

SELECT DISTINCT
C.NOMERAZAO,
C.NROCGCCPF||'-'||C.DIGCGCCPF,
B.NROEMPRESA,
A.CODOPERACAO,
D.DESCRICAO,
SUBSTR(REGEXP_REPLACE(A.OBSERVACAO, '[^0-9]', ''), 1,LENGTH(REGEXP_REPLACE(A.OBSERVACAO, '[^0-9]', '')) - 2) AS TITULO_REFERENCIA,
TO_CHAR(''),
B.NROTITULO||'-'||B.SERIETITULO AS TITULO, 
B.CODESPECIE,
A.OBSERVACAO,
TO_CHAR(B.DTAPROGRAMADA, 'DD/MM/YYYY') AS DATA_PROGRAMADA,
TO_CHAR(B.DTAQUITACAO, 'DD/MM/YYYY') AS DATA_QUITACAO,
TO_CHAR(A.VLROPERACAO),
TO_CHAR('')
FROM CONSINCO.FI_TITOPERACAO A INNER JOIN CONSINCO.FI_TITULO B ON A.SEQTITULO = B.SEQTITULO
INNER JOIN CONSINCO.FI_TITULO BB ON BB.NROTITULO = SUBSTR(REGEXP_REPLACE(A.OBSERVACAO, '[^0-9]', ''), 1,LENGTH(REGEXP_REPLACE(A.OBSERVACAO, '[^0-9]', '')) - 2) AND BB.NROEMPRESA = B.NROEMPRESA
INNER JOIN CONSINCO.GE_PESSOA C ON B.SEQPESSOA = C.SEQPESSOA
INNER JOIN CONSINCO.FI_OPERACAO D ON A.CODOPERACAO = D.CODOPERACAO
INNER JOIN CONSINCO.GE_REDEPESSOA E ON E.SEQPESSOA = B.SEQPESSOA
WHERE B.CODESPECIE IN ('ACORDO','ACORIM','ACRBIN','ACRCOM','ACRCON','ACRDIV','ACRECO','ACRING','ACRINT','ACRLOG','ACRMCA','ACRMDN','ACRMKT','ACRMSL','ACRPRE','ACRTRO','DEVREC','DEVRIM','CONTLG','CONTRT','CONTVB')
AND B.DTAVENCIMENTO BETWEEN :DT3 AND :DT4
AND E.SEQREDE =  :LT1
AND A.CODOPERACAO != 16
ORDER BY EMPRESA, CNPJ, TITULO, CODESPECIE DESC;
