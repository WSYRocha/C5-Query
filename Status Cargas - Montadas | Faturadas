-- Chamado 775582

SELECT A.NROEMPRESA AS EMPRESA,
'M'||A.SEQPALETECARREG AS ETIQUETA,
A.NOMERAZAOCLIENTE AS LOJA,
TO_CHAR(B.DTAHORINIMONT, 'DD/MM/YYYY HH24:MI') AS INICIO_MONTAGEM,
TO_CHAR(B.DTAHORFINALMONT, 'DD/MM/YYYY HH24:MI') AS FIM_MONTAGEM,
A.DESCSITUACAOPED AS STATUS,
A.DOCUMENTO,
TO_CHAR(A.DTAINCLUSAO, 'DD/MM/YYYY HH24:MI') AS DATA_FATURAMENTO,
A.SEQPRODUTO,
A.DESCPRODUTO,
A.QTDATENDIDAEMB AS QUANTIDADE,
A.EMBALAGEM,
A.NROCARGA AS CARGA
FROM CONSINCO.MLOV_PEDVENDA_SORTER A INNER JOIN CONSINCO.MLO_PALETECARREG B ON A.SEQPALETECARREG = B.SEQPALETECARREG
WHERE TRUNC(A.DTAINCLUSAO) BETWEEN :DT1 AND :DT2
AND A.NROEMPRESA IN (#LS1)
AND A.SITUACAOPED = 'F'
ORDER BY 3;
