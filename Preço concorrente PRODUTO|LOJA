SELECT
NROEMPRESA,
SEQFAMILIA,
SEQPRODUTO,
DESCCOMPLETA,
NOMEREDUZIDO,
TO_CHAR(DTAPESQUISA, 'DD/MM/YYYY') AS DATA_PESQUISA,
VLRPRECOPRATICADO,
TO_CHAR(DTAVALIDADE, 'DD/MM/YYYY') AS DATA_VALIDADE
FROM (SELECT
A.NROEMPRESA,
A.SEQFAMILIA,
D.SEQPRODUTO,
D.DESCCOMPLETA,
C.NOMEREDUZIDO,
A.DTAPESQUISA,
A.VLRPRECOPRATICADO,
A.DTAVALIDADE,
ROW_NUMBER() OVER (PARTITION BY A.NROEMPRESA, A.SEQFAMILIA
ORDER BY A.VLRPRECOPRATICADO) AS RN
FROM CONSINCO.MRL_COTACAO A
INNER JOIN CONSINCO.ETLV_CATEGORIA_V2 B ON A.SEQFAMILIA = B.SEQFAMILIA
INNER JOIN CONSINCO.MRL_CONCORRENTE C ON A.SEQCONCORRENTE = C.SEQCONCORRENTE
INNER JOIN CONSINCO.MAP_PRODUTO D ON A.SEQFAMILIA = D.SEQFAMILIA
WHERE A.DTAVALIDADE >= SYSDATE
AND B.CATEGORIAN1 = 'MERCEARIA SALGADA')
WHERE RN = 1
ORDER BY 1,4;
