Solicitação prevenção


-- Receita e Componentes
SELECT DISTINCT A.SEQRECEITARENDTO AS CODIGO_RECEITA,
D.PRODUTOFINAL AS DESCRICAO_PRODUTO_FINAL,
D.SEQPRODUTOFINAL AS PLU_FINAL,
C.DESCCOMPLETA AS DESCRICAO_COMPLETA_COMPONENTES,
C.SEQPRODUTO AS SEQ_COMPONENTES,
B.QTDUNIDUTILIZADA,
C.SEQPRODUTOBASE,
C.PROPQTDPRODUTOBASE,
C.PROPQTDPERDAAUTO,
CASE 
WHEN A.STATUSRECRENDTO = 'A' THEN 'ATIVO'
WHEN A.STATUSRECRENDTO = 'I' THEN 'INATIVO'
END AS STATUS,
TO_CHAR(A.DTAHORALTERACAO, 'DD/MM/YYYY HH24:MI') AS DATA_ALTERACAO
FROM CONSINCO.MRL_RECEITARENDTO A INNER JOIN CONSINCO.MRL_RRCOMPONENTE B ON A.SEQRECEITARENDTO = B.SEQRECEITARENDTO
INNER JOIN CONSINCO.MAP_PRODUTO C ON B.SEQPRODUTO = C.SEQPRODUTO
INNER JOIN CONSINCO.MRLV_COMPONENTESRECEITA D ON A.SEQRECEITARENDTO = D.SEQRECEITARENDTO
WHERE A.INDRECEITARENDTO = 'C'
ORDER BY A.SEQRECEITARENDTO, 4;


--Produtos com cadastro de produto base
SELECT A.SEQPRODUTO, 
A.DESCCOMPLETA, 
A.SEQPRODUTOBASE, 
B.DESCCOMPLETA AS DESC_PRODBASE,
A.PROPQTDPRODUTOBASE
FROM CONSINCO.MAP_PRODUTO A INNER JOIN CONSINCO.MAP_PRODUTO B ON A.SEQPRODUTOBASE = B.SEQPRODUTO
WHERE A.SEQPRODUTOBASE > 0
ORDER BY A.DESCCOMPLETA;

-- Produtos que tem Proporção Perda Automática
SELECT A.SEQPRODUTO, 
A.DESCCOMPLETA, 
A.PROPQTDPERDAAUTO
FROM CONSINCO.MAP_PRODUTO A
WHERE A.PROPQTDPERDAAUTO > 0
ORDER BY A.DESCCOMPLETA;
