SELECT A.NROEMPRESA,
A.DESCRICAO, 
A.SEQPRODUTO,
C.DESCCOMPLETA,
TO_CHAR(A.DTAINICIO, 'DD/MM/YYYY') AS DATA_INICIO, 
TO_CHAR(A.DTAFIM, 'DD/MM/YYYY') AS DATA_FIM,
B.PRECOGERPROMOC AS PRECO_OFERTA,
A.PRECO_FINAL AS PRECO_CARTAO  
FROM CONSINCO.NAGV_PROMOC_ATIVAS_REGRAPDV A INNER JOIN CONSINCO.MRL_PRODEMPSEG B
ON A.SEQPRODUTO = B.SEQPRODUTO AND A.NROEMPRESA = B.NROEMPRESA
INNER JOIN CONSINCO.MAP_PRODUTO C ON A.SEQPRODUTO = C.SEQPRODUTO
WHERE B.QTDEMBALAGEM = 1
AND B.NROSEGMENTO IN (2,3)
AND A.SEQPRODUTO = :NR1
AND A.NROEMPRESA IN (#LS1)
ORDER BY A.NROEMPRESA;
