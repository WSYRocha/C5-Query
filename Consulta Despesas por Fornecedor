SELECT 
    X.NRONOTA,
    X.SERIE,
    B.CODPRODUTO,
    B.DESCRICAO,
    X.SEQPESSOA,
    X.MODELONF,
    X.FORNECEDOR,
    X.FANTASIA,
    X.NROEMPRESA,
    to_char(X.DTAEMISSAO,'DD/MM/YYYY') DATA_EMISSAO,
    to_char(X.DTAENTRADA,'DD/MM/YYYY') DATA_EMISSAO,    
    X.VALOR,
    X.VLRDESCONTOS,
    X.CODHISTORICO,
    X.REQUISICAO,
    X.AUTORIZADOR,
    X.NOME_AUTORIZADOR,
    X.HISTORICO,
    X.OBSERVACAO,
    X.COMPRADORDESPESA,
    X.OBS_REQUISICAO
FROM consinco.NAGV_ETLNFDESPESAS_TOTAL x INNER JOIN consinco.OR_NFITENSDESPESA B ON X.seqnota = B.SEQNOTA
where X.seqpessoa IN (LT1)
AND X.dtaentrada BETWEEN :DT1 AND :DT2
