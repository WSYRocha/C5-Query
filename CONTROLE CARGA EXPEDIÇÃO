--CHAMADO 762109


SELECT A.NROEMPRESA AS ORIGEM,
A.NROCARGA AS CARGA,
A.DESTINO AS DESCRICAO,
TO_CHAR(A.DTAHORGERACAO, 'DD/MM/YYYY HH24:MI') AS DATA_GERACAO,
CASE 
WHEN A.STATUSCARGA = 'F' THEN 'FATURADA' 
WHEN A.STATUSCARGA = 'S' THEN 'EM SEPARACAO'
WHEN A.STATUSCARGA = 'A' THEN 'NAO SEPARADA'
END AS STATUS,
A.USUGERACAO AS USUARIO,
B.SEQPRODUTO AS PLU,
D.DESCCOMPLETA AS PRODUTO,
E.EMBALAGEM ||'-'|| B.QTDEMBALAGEM AS QTD_EMBALAGEM,
SUM(B.QTDEMBSOLICITADA) AS QTD_SOLICITADA,
SUM(B.QTDEMBSEPARADA) AS QTD_SEPARADA
FROM CONSINCO.MLO_CARGAEXPED A
INNER JOIN CONSINCO.MLO_CARGAEXPPROD B ON A.NROCARGA = B.NROCARGA
INNER JOIN CONSINCO.MAP_PRODUTO D ON B.SEQPRODUTO = D.SEQPRODUTO
INNER JOIN CONSINCO.MLO_PRODEMBALAGEM E ON B.SEQPRODUTO = E.SEQPRODUTO AND B.QTDEMBALAGEM = E.QTDEMBALAGEM AND A.NROEMPRESA = E.NROEMPRESA
WHERE TRUNC(A.DTAHORGERACAO) = :DT1
AND A.NROEMPRESA = (#LS1)
GROUP BY A.NROEMPRESA,
A.NROCARGA,
A.DESTINO,
TO_CHAR(A.DTAHORGERACAO, 'DD/MM/YYYY HH24:MI'),
A.STATUSCARGA,
A.USUGERACAO,
B.SEQPRODUTO,
D.DESCCOMPLETA,
E.EMBALAGEM ||'-'|| B.QTDEMBALAGEM
ORDER BY A.NROCARGA, D.DESCCOMPLETA;
