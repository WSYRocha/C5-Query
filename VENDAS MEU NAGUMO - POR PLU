SELECT TO_CHAR(C.DTAMOVIMENTO, 'DD/MM/YYYY') AS DTA_MOVIMENTO,
C.NROEMPRESA,
E.SEQPROMOCPDV, 
B.SEQPRODUTO, 
D.DESCCOMPLETA, 
E.PRECOPROMOCAO, 
B.QTDEMBALAGEM, 
TO_CHAR(''), 
SUM(B.VLRITEM - B.VLRDESCONTO) AS VALOR_TOTAL_VENDA, 
SUM(B.QUANTIDADE) AS QUANTIDADE_VENDA, 
SUM(B.VLRDESCONTO) AS VALOR_TOTAL_DESCONCO, 
TO_CHAR(E.DTAINICIO, 'DD/MM/YYYY') AS INICIO_PROMO, 
TO_CHAR(E.DTAFIM, 'DD/MM/YYYY') AS FIM_PROMO, 
G.COMPRADOR 
FROM CONSINCO.MFL_DOCTOFIDELIDADE A
INNER JOIN CONSINCO.MFL_DFITEM B ON A.SEQNF = B.SEQNF
INNER JOIN CONSINCO.MFL_DOCTOFISCAL C ON A.SEQNF = C.SEQNF
INNER JOIN CONSINCO.MAP_PRODUTO D ON B.SEQPRODUTO = D.SEQPRODUTO
INNER JOIN CONSINCO.NAGV_BASE_PROMOC_PDV_MN_SF E ON E.DTAFIM >= C.DTAMOVIMENTO 
AND E.DTAINICIO <= C.DTAMOVIMENTO 
AND B.SEQPRODUTO = E.SEQPRODUTO 
AND B.NROEMPRESA = E.NROEMPRESA 
INNER JOIN CONSINCO.MAP_FAMDIVISAO F ON D.SEQFAMILIA = F.SEQFAMILIA
INNER JOIN CONSINCO.MAX_COMPRADOR G ON F.SEQCOMPRADOR = G.SEQCOMPRADOR
WHERE C.DTAMOVIMENTO BETWEEN :DT1 AND :DT2
AND B.SEQPRODUTO = :NR1
AND C.NROEMPRESA IN (#LS1)
AND C.STATUSDF = 'V'
AND B.STATUSITEM = 'V'
AND B.VLRDESCONTO > 0
GROUP BY C.DTAMOVIMENTO, C.NROEMPRESA, B.SEQPRODUTO, D.DESCCOMPLETA, E.SEQPROMOCPDV, E.PRECOPROMOCAO, B.QTDEMBALAGEM, E.DTAINICIO, E.DTAFIM, G.COMPRADOR


UNION 

SELECT DISTINCT TO_CHAR(C.DTAMOVIMENTO, 'DD/MM/YYYY'), 
TO_NUMBER(''), 
TO_NUMBER(''),
B.SEQPRODUTO, 
D.DESCCOMPLETA, 
E.PRECOPROMOCAO, 
B.QTDEMBALAGEM, 
'TOTAL', 
SUM(B.VLRITEM - B.VLRDESCONTO), 
SUM(B.QUANTIDADE), 
SUM(B.VLRDESCONTO), 
TO_CHAR(E.DTAINICIO, 'DD/MM/YYYY'),
TO_CHAR(E.DTAFIM, 'DD/MM/YYYY'),
G.COMPRADOR
FROM CONSINCO.MFL_DOCTOFIDELIDADE A
INNER JOIN CONSINCO.MFL_DFITEM B ON A.SEQNF = B.SEQNF
INNER JOIN CONSINCO.MFL_DOCTOFISCAL C ON A.SEQNF = C.SEQNF
INNER JOIN CONSINCO.MAP_PRODUTO D ON B.SEQPRODUTO = D.SEQPRODUTO
INNER JOIN CONSINCO.NAGV_BASE_PROMOC_PDV_MN_SF E ON E.DTAFIM >= C.DTAMOVIMENTO 
AND E.DTAINICIO <= C.DTAMOVIMENTO 
AND B.SEQPRODUTO = E.SEQPRODUTO 
AND B.NROEMPRESA = E.NROEMPRESA
INNER JOIN CONSINCO.MAP_FAMDIVISAO F ON D.SEQFAMILIA = F.SEQFAMILIA
INNER JOIN CONSINCO.MAX_COMPRADOR G ON F.SEQCOMPRADOR = G.SEQCOMPRADOR
WHERE C.DTAMOVIMENTO BETWEEN :DT1 AND :DT2
AND B.SEQPRODUTO = :NR1
AND C.NROEMPRESA IN (#LS1)
AND C.STATUSDF = 'V'
AND B.STATUSITEM = 'V'
AND B.VLRDESCONTO > 0
GROUP BY C.DTAMOVIMENTO, B.SEQPRODUTO, D.DESCCOMPLETA, E.PRECOPROMOCAO, B.QTDEMBALAGEM, E.DTAINICIO, E.DTAFIM, G.COMPRADOR
ORDER BY 2;
