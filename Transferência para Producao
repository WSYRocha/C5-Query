Chamado Estoque 762102

select T.NROEMPRESA,
TO_CHAR(T.DTAENTRADASAIDA,'DD/MM/YYYY') as DTAENTSAIDA,
       T.SEQPRODUTOSAIDA,
       T.DESCPRODUTOSAIDA,
  TRUNC(SUM(T.QTDLANCTOSAIDA),2) as QTDLANCTOSAIDA,
  TRUNC(SUM(T.CUSTOSAIDA),2)as CUSTOSAIDA ,
       T.LOCALORIGEM,
       T.FATORCONVERSAO,
       T.SEQPRODUTOENTRADA,
       T.DESCPRODUTOENTRADA,
       T.EMBALAGEMENTRADA,
  TRUNC(SUM(T.QTDLANCTOENTRADA),2) as QTDLANCTOENTRADA,
  TRUNC(SUM(T.CUSTOENTRADA),2) as CUSTOENTRADA ,
       T.LOCALDESTINO,
       T.USULANCTO,
TO_CHAR(T.DTAHORLANCTO, 'DD/MM/YYYY') as DTAHORLANCTO
  from CONSINCO.MAXV_TRANSFPRODUCAO T
 where TIPOREG = 'T'
   AND (DTAENTRADASAIDA) >= :DT1
   AND (DTAENTRADASAIDA) <= :DT2
   AND NROEMPRESA IN (#LS1)
   GROUP BY
    T.NROEMPRESA,
       T.DTAENTRADASAIDA,
       T.SEQPRODUTOSAIDA,
       T.DESCPRODUTOSAIDA,
       T.EMBALAGEMSAIDA,
       T.LOCALORIGEM,
       T.FATORCONVERSAO,
       T.SEQPRODUTOENTRADA,
       T.DESCPRODUTOENTRADA,
       T.EMBALAGEMENTRADA,
       T.LOCALDESTINO,
       T.USULANCTO,
       T.DTAHORLANCTO   
       UNION SELECT L.NROEMPRESA, 
TO_CHAR(L.DTAENTRADASAIDA,'DD/MM/YYYY'),
 L.SEQPRODUTO,
  P.DESCCOMPLETA,
  L.QTDLANCTO,
  round(L.VALORVLRNF,2),
  case
  when L.LOCAL IN (1,3,159,165,471,500,520,582,591,659,668,673) then 'LOJA'
  when L.LOCAL IN (2,4,160,476,491,499,526,590,599,660,669,674) then 'AVARIA'
  end,
  TO_NUMBER(''),
  L.SEQPRODUTO,
  '',
  '',
  TO_NUMBER(''),
  TO_NUMBER('') ,
  L.HISTORICO,
  case
  when L.USULANCTO = 'TKT13038516' then 'NAP'
  end,
  TO_CHAR(L.DTAHORLANCTO)
FROM CONSINCO.MRL_LANCTOESTOQUE L INNER JOIN CONSINCO.MAP_PRODUTO P ON L.SEQPRODUTO = P.SEQPRODUTO 
 WHERE L.NROEMPRESA = (#LS1)
   AND L.DTAENTRADASAIDA = :DT1
   AND L.USULANCTO = 'TKT13038516';
